# Copie para .env e substitua por uma senha longa e exclusiva.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Hosts públicos roteados pelo NGINX. Substitua pelos domínios do ambiente.
KORP_APP_HOST=korp-app.example.com
KORP_GRAFANA_HOST=korp-grafana.example.com
KORP_PROMETHEUS_HOST=korp-prometheus.example.com
